{
  "name": "@fparedlo/freecommerce",
  "description": "This is an open source ecommerce build on modern technologies and with startups and little businesses in mind.",
  "private": false,
  "version": "0.1.3",
  "type": "module",
  "license": "MIT",
  "author": "Ferran Paredes (https://www.linkedin.com/in/fparedlo)",
  "repository": {
    "type": "git",
    "url": "https://github.com/fparedlo/freeCommerce.git"
  },
  "keywords": [
    "ecommerce",
    "react",
    "typescript",
    "vite",
    "tailwind"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm lint && pnpm format && vite build && tsc -b",
    "preview": "vite preview",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format": "pnpm exec prettier ./src --write",
    "format:check": "prettier ./src --check",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-devtools": "^5.99.0",
    "@tanstack/react-router": "^1.168.22",
    "@tanstack/react-router-devtools": "^1.166.13",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tanstack/eslint-plugin-query": "^5.99.0",
    "@tanstack/router-plugin": "^1.167.22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "brace-expansion": "5.0.6"
  }
}
