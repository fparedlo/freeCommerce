{
  "name": "@fparedlo/freecommerce",
  "description": "This is an open source ecommerce build on modern technologies and with startups and little businesses in mind.",
  "private": false,
  "version": "0.1.3",
  "type": "module",
  "license": "MIT",
  "author": "Ferran Paredes (https://www.linkedin.com/in/fparedlo)",
  "repository": {
    "type": "git",
    "url": "https://github.com/fparedlo/freeCommerce.git"
  },
  "keywords": [
    "ecommerce",
    "react",
    "typescript",
    "vite",
    "tailwind"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm lint && pnpm format && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format": "pnpm exec prettier ./src --write",
    "format:check": "prettier ./src --check",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-router": "^1.141.6",
    "@tanstack/react-router-devtools": "^1.141.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.1.18",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@tanstack/router-plugin": "^1.141.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  }
}
